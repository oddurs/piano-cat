# dependencies
node_modules/
.pnp
.pnp.*

# next
/.next/
/out/
# next rewrites this differently for `next dev` vs `next build`, so tracking it
# means a permanently dirty file. tsc --noEmit passes without it.
next-env.d.ts
*.tsbuildinfo

# headless render output (npm run shot)
/.shots/

# env
.env*.local

# os / editor
.DS_Store
*.pem
.vscode/
.idea/

# logs
npm-debug.log*
yarn-error.log*
.npm

# test build output
.test-build/

# hand tracker, provisioned at build time by scripts/fetch-mediapipe.mjs.
# 30 MB of wasm and model weights that git has no reason to carry.
/public/mediapipe/
